[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true
3d/physics_engine="GodotPhysics3D"
3d/run_on_separate_thread=false

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
mesh_lod/lod_change/threshold_pixels=2.0
scaling_3d/mode=2
scaling_3d/scale=0.71
scaling_3d/fsr_sharpness=0.1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/volumetric_fog/volume_size=24
environment/volumetric_fog/volume_depth=24
environment/volumetric_fog/use_filter=1

[trailhead_render]

height_fog_density=0.018
height_fog_falloff=1.0
camera_far=42.0
