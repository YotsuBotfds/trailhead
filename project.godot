; Engine configuration file.
; Prefer the Godot editor for large setting changes; keep hand edits minimal.

config_version=5

[application]

config/name="Trailhead"
run/main_scene="res://scenes/flat_plane.tscn"

[autoload]

GameConfig="*res://autoload/game_config.gd"
EventBus="*res://autoload/event_bus.gd"
GameManager="*res://autoload/game_manager.gd"

[physics]

common/physics_ticks_per_second=60

